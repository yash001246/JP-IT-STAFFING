PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/emailpro
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Email providers (optional, used by /api/settings routes)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# SMTP (used for actually sending campaign emails — required for Campaign Builder to work)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
FROM_NAME=EmailPro
FROM_EMAIL=
RESEND_API_KEY=
